# Template for the ISOLATED test environment used by `npm test`.
#
# Copy this to `.env.test` for local runs (already gitignored — see
# .gitignore's `.env*` rule) and fill in a LOCAL/CI-ONLY MongoDB instance.
#
# scripts/assertTestDbSafety.mjs runs automatically before every `npm test`
# (npm's `pretest` hook) and refuses to proceed if:
#   - NODE_ENV isn't "test" (the npm script sets this for you)
#   - MONGO_URI_TEST equals MONGO_URI
#   - MONGO_URI_TEST looks like a hosted/production database (Atlas, etc.)
#
# NEVER put real production values in this file. NEVER copy values from the
# real .env here. Every value below should be a throwaway, local-only, or
# CI-generated credential.

# A local (or CI service-container) MongoDB running AS A REPLICA SET.
# Order-creation tests use a real Mongoose transaction (session.withTransaction),
# which MongoDB only supports on a replica set — a plain standalone mongod
# will make those specific tests skip themselves with a clear message
# instead of failing. See .github/workflows/ci.yml for how CI provisions one.
MONGO_URI_TEST=mongodb://127.0.0.1:27017/tahos_test?replicaSet=rs0&directConnection=true

# Any value works — this only needs to round-trip jwt.sign()/jwt.verify()
# inside this test run. Do not reuse the real JWT_SECRET.
JWT_SECRET=test-only-secret-do-not-use-in-production
JWT_EXPIRES_IN=1h

# Used by the password-reset-link tests, overridden per-test-case in code —
# this value only matters for any test that doesn't explicitly set it itself.
CLIENT_URL=http://localhost:3000

# Cloudinary/SMTP are intentionally NOT listed here: the current Phase 1
# test suite never calls the real Cloudinary SDK or a real SMTP transport —
# uploads aren't exercised yet, and email sending is mocked via
# node:test's mock.module("nodemailer", ...) in every test that would
# otherwise trigger a real send. Add real (still test-only) values here only
# once a future phase adds tests that need them.
