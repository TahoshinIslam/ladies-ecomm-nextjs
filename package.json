{
  "name": "ladies-ecomm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:org": "node scripts/devForOrg.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.check.json",
    "seed": "node --env-file=.env scripts/seedCatalog.mjs",
    "pretest": "NODE_ENV=test node --env-file-if-exists=.env.test scripts/assertTestDbSafety.mjs",
    "test": "NODE_ENV=test node --experimental-test-module-mocks --import ./tests/helpers/nextResolveHook.mjs --env-file-if-exists=.env.test --test --test-concurrency=1 tests/*.test.mjs",
    "test:core": "npm run test",
    "pretest:http": "npm run build && NODE_ENV=test node --env-file-if-exists=.env.test scripts/assertTestDbSafety.mjs",
    "test:http": "node --env-file-if-exists=.env.test scripts/httpTestServer.mjs run",
    "test:all": "npm run test:core && npm run test:http",
    "validate:production": "node scripts/validateProductionEnv.mjs",
    "test:multi-instance": "node --env-file-if-exists=.env.test scripts/multiInstanceHttpTestServer.mjs run",
    "test:http:cold-start": "node --env-file-if-exists=.env.test scripts/coldStartHttpTestServer.mjs run",
    "smoke": "node scripts/smokeDeployment.mjs",
    "check:tenancy": "node scripts/checkTenantScoping.mjs",
    "test:tenancy": "node --import ./tests/helpers/nextResolveHook.mjs --env-file=.env scripts/testTenantIsolation.mjs",
    "test:db:setup": "NODE_ENV=test node --env-file=.env.test scripts/setupTestDb.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@vercel/functions": "^3.9.5",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.39.0",
    "mysql2": "^3.24.4",
    "next": "16.3.8",
    "nodemailer": "10.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "slugify": "^1.6.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
