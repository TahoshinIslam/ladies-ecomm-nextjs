# Template for the real application environment (.env / .env.local /
# production deployment config). Copy this to .env and fill in real values —
# never commit the real file (see .gitignore's `.env*` rule).
#
# For the ISOLATED test-only environment used by `npm test`, see
# .env.test.example instead — never reuse values between the two files.

# --- Database ---
MONGO_URI=
PORT=

# --- Cloudinary (image uploads) ---
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# Phase 2 — session/cookie authentication (replaces the old bearer-JWT vars)
# =============================================================================

# The canonical, single origin this app is actually served from in this
# environment — e.g. https://tahos.store in production,
# http://localhost:3000 for local dev. Used ONLY for CSRF Origin validation
# (lib/csrf.js's Layer 1): an unsafe (POST/PUT/PATCH/DELETE) request whose
# Origin header doesn't exactly match this is rejected before it reaches any
# route handler.
#
# REQUIRED in production. If unset, the fallback is "whatever host/scheme
# the request itself arrived on" — fine for local single-process dev, NOT
# safe behind a reverse proxy or a multi-origin deployment, where that
# fallback could disagree with the origin browsers actually see. Set this
# explicitly in every deployed environment.
APP_ORIGIN=

# The same canonical origin as APP_ORIGIN above, but read by a different
# code path (lib/appUrl.js's resolveAppOrigin(), used for absolute links
# this app builds itself — password-reset/verification emails, and, as of
# Phase 10, SEO metadataBase/canonical URLs/sitemap.xml/robots.txt via
# lib/seo.js). REQUIRED in production for real absolute URLs anywhere in
# the app; both this app-generated-link path AND the CSRF path
# independently reject `http://localhost...` once NODE_ENV=production, so
# a real deployment must set this to the exact same public origin as
# APP_ORIGIN (e.g. https://tahos.store). Missing/invalid values never
# crash a request — lib/seo.js's absoluteUrl()/getSiteOrigin() catch the
# failure and degrade metadata/sitemap/robots to relative URLs rather
# than fabricating a wrong one or leaking the underlying error detail.
CLIENT_URL=

# How long an issued session stays valid before it expires on its own,
# independent of explicit revocation (logout, password change/reset).
# Optional — defaults to 30 days if unset. Also governs the session cookie's
# Max-Age.
SESSION_MAX_AGE_DAYS=30

# Maximum number of concurrent active sessions kept per user; creating a new
# one beyond this revokes the oldest. Optional — defaults to 10 if unset.
# Exists to bound unbounded session accumulation (e.g. a script or bot
# repeatedly hitting /login), not as a real "device limit" feature.
MAX_SESSIONS_PER_USER=10

# No session-signing secret is needed or defined here on purpose: sessions
# are opaque, cryptographically random 256-bit tokens (crypto.randomBytes),
# not JWTs — there is nothing to sign or verify with a shared secret, only a
# SHA-256 hash to look up in the database. Do not invent a SESSION_SECRET;
# none of this code reads one.
#
# JWT_SECRET / JWT_EXPIRES_IN (the old bearer-token vars) are no longer read
# by any code as of Phase 2 — remove them from your real .env once you've
# confirmed the migration; they're harmless if left, just unused.
#
# DEPLOYMENT NOTE: every previously issued bearer JWT is rejected the
# moment this deploys — there is no bearer/cookie compatibility window by
# design. Every currently logged-in user, across every device, will be
# signed out and must log in again to receive a new session cookie. This
# is intentional, not a bug to work around.
#
# KNOWN, DOCUMENTED, LOWER-PRIORITY RISK — session timeout model (not
# changed in this closure; characterized here on purpose, not fixed, since
# changing it is outside the agreed Phase 2 product behavior):
#   - SESSION_MAX_AGE_DAYS is an ABSOLUTE lifetime from the moment a
#     session is created (see lib/session.js's createSession()). It does
#     NOT slide/reset on activity — expiresAt is set once and never
#     extended anywhere in the codebase.
#   - lastSeenAt is written (throttled to at most once per 5 minutes) but
#     is NEVER read back for any authentication/authorization decision —
#     it exists only as future-UI metadata ("your active sessions"), not
#     as an idle-timeout mechanism. There is currently no idle timeout at
#     all.
#   - Consequence: a session that is created and then genuinely abandoned
#     (the user walks away, never explicitly logs out, never returns)
#     stays fully valid for the ENTIRE 30-day (or configured) window,
#     regardless of how long it sits idle.
#   - Administrator/staff risk: this applies equally to admin/employee
#     sessions, which carry write access to orders, coupons, products, and
#     user management — an abandoned staff session on a shared or public
#     device remains a live credential for up to the full configured
#     lifetime, not just until the next idle check.
#   - Recommendation for a future phase: a materially shorter
#     SESSION_MAX_AGE_DAYS specifically for admin/employee roles, and/or a
#     real idle timeout (revoke a session if lastSeenAt is older than some
#     threshold, checked inside validateSessionToken()). Neither is
#     implemented here.

# =============================================================================
# Transactional email (SMTP) — password-reset emails
# =============================================================================
# Read directly by utlis/sendEmail.js via nodemailer.createTransport(). All
# four are required for password-reset emails to actually deliver; if
# unset, nodemailer will fail at send time (the failure is caught by the
# calling route and never exposed to the client — see the forgot-password
# route's enumeration-safe generic response).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional display name/address for the "From" header. Defaults to
# "TAHOS." <noreply@tahos.store> if unset.
FROM_NAME=
FROM_EMAIL=

# --- Testing documentation ---
# See .env.test.example for the isolated test-database contract used by
# `npm run test:core`. Phase 2's new session/CSRF tests (tests/session.test.mjs)
# use the same JWT_SECRET-free path — they sign nothing; they exercise real
# cookies against the real Route Handlers, so no additional test-only auth
# variable is needed beyond what .env.test.example already documents
# (MONGO_URI_TEST, CLIENT_URL). APP_ORIGIN is not required for the test
# suite: tests construct same-origin Request objects directly, so the
# same-origin fallback in lib/csrf.js's canonicalOrigin() applies.

# =============================================================================
# Phase 3 — rate limiting, client-IP trust, and security headers
# =============================================================================

# --- Rate-limiter backend ---
# MongoDB-backed (see lib/rateLimit.js / models/rateLimitModel.js), NOT
# Redis. This codebase previously had old Express-era files (config/redis.js,
# app/middleware/rateLimiter.js, utlis/cache.js) that referenced Redis;
# they were confirmed to have zero live consumers and removed in Phase 6.
# Redis is not connected here — do not add REDIS_URL expecting it to
# change the rate limiter's backend; it would do nothing. Every counter
# lives in the same MongoDB database every instance already connects to
# (config/db.js), which is what makes the limiter work correctly across
# multiple Node/serverless instances with no in-memory state.

# --- Client-IP trust model ---
# CONFIRMED PRODUCTION PLATFORM (Phase 3C): this application is deployed
# on Vercel (tahostore.vercel.app). Client-IP resolution therefore has TWO
# tiers, tried in this order:
#
#   1. VERCEL (primary, automatic — no configuration needed below).
#      Detected via process.env.VERCEL === "1", which Vercel sets itself
#      at both build and runtime whenever the project has "Enable access
#      to System Environment Variables" turned on in Project Settings →
#      Environment Variables (Vercel's own default-recommended setting).
#      *** If that setting is ever turned OFF, this file has no way to
#      detect it is running on Vercel, and falls through to tier 2 below
#      — with nothing configured there either, register/reset-password
#      then fail closed in production. Keep that setting ON. ***
#
#      When detected, client IP comes ONLY from the official
#      `ipAddress(request)` helper in the `@vercel/functions` package
#      (already a dependency — see package.json), which reads Vercel's
#      own `x-real-ip` header — verified directly against that package's
#      published source, not assumed from prose docs. Per Vercel's own
#      documentation (vercel.com/docs/headers/request-headers):
#        "If you are trying to use Vercel behind a proxy, we currently
#        overwrite the X-Forwarded-For header and do not forward
#        external IPs. This restriction is in place to prevent IP
#        spoofing." — and x-real-ip "is identical to the x-forwarded-for
#        header," so it inherits the same guarantee. A client-supplied
#        X-Forwarded-For/X-Real-IP is therefore discarded and replaced by
#        Vercel's edge network on every request, UNLESS this account has
#        purchased Vercel's Enterprise "Trusted Proxy" add-on to
#        explicitly allow a custom X-Forwarded-For from a proxy placed in
#        front of Vercel itself — not applicable to this deployment, and
#        not assumed by this code. This app never manually selects an
#        X-Forwarded-For hop when on Vercel; it always defers entirely to
#        the official resolver.
#
#   2. GENERIC REVERSE PROXY (fallback — only consulted when
#      process.env.VERCEL is NOT "1"). For any other self-hosted
#      deployment. Requires explicit configuration below; remains fully
#      disabled otherwise. Once you have confirmed your real production
#      topology — exactly how many reverse proxies sit between the
#      internet and this Node process, and that your proxy actually
#      OVERWRITES or safely appends X-Forwarded-For rather than passing
#      through whatever a client sent — set:
TRUST_PROXY_HEADERS=
# ("true" to enable; anything else, including unset, means "trust nothing")
TRUSTED_PROXY_HOP_COUNT=
# (a positive integer — the exact number of trusted proxies; the client IP
# is read as the X-Forwarded-For entry exactly that many positions from
# the RIGHT, so a client can never spoof it by prepending fake entries at
# the left of the header). An invalid value here (zero, negative, non-
# integer, non-numeric) is treated as MISCONFIGURED and never silently
# defaulted to 1 — guessing a hop count risks trusting an attacker-
# controlled entry, which is worse than refusing to resolve an IP at all.
# A chain shorter than the configured hop count, or a value that isn't a
# real IPv4/IPv6 address (validated with Node's own net.isIP(), not a
# custom regex), is likewise rejected outright rather than accepted as-is.
#
# Consequence when NEITHER tier resolves an IP: login and forgot-password
# each have a SECOND dimension (the normalized account/email) that still
# fully applies with no IP at all — they are never left unprotected.
# register and reset-password have NO other dimension — IP is their ONLY
# protection. In PRODUCTION (NODE_ENV=production; `next start` always runs
# as production regardless of what NODE_ENV is set to), these two routes
# FAIL CLOSED: 503, never a silent unprotected pass-through, and never a
# shared "unknown"/"anonymous" identity that would let one attacker's
# traffic block every other client. This means **register and
# password-reset are unavailable in production on any platform this file
# doesn't recognize and that hasn't configured tier 2.** That is
# intentional. (Outside production — the automated test suite, `next
# dev` — these two routes instead skip the IP dimension gracefully;
# this carve-out can never reach a real deployment, since `next start`
# cannot be coaxed into NODE_ENV !== "production".)

# --- Rate-limit windows and defaults ---
# Every value below is validated (lib/rateLimit.js's resolveBoundedInt()):
# zero, negative, NaN, non-integer, or absurdly large values are rejected
# and the code-reviewed default is used instead — an env typo cannot
# accidentally disable or misconfigure a limit.
RATE_LIMIT_LOGIN_IP_MAX=20               # per 15 minutes
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10          # per 15 minutes — deliberately HIGHER than userModel.js's 5-attempt lockout threshold; a real test failure during this phase caught the collision when both were set to 5 (the rate limiter's generic 429 masked lockout's specific 423 on the same request) — lockout is the primary defense here, this is a coarser backstop layered on top of it, not a replacement
RATE_LIMIT_REGISTER_IP_MAX=5             # per hour
RATE_LIMIT_FORGOT_PASSWORD_IP_MAX=5      # per 15 minutes
RATE_LIMIT_FORGOT_PASSWORD_ACCOUNT_MAX=3 # per hour — keyed off the submitted email only, never a DB lookup, so it cannot introduce enumeration
RATE_LIMIT_RESET_PASSWORD_IP_MAX=10      # per 15 minutes — IP only; the raw reset token is never used as a rate-limit identity
RATE_LIMIT_COUPON_VALIDATE_USER_MAX=30   # per minute, per authenticated user

# --- Rate-limit store-failure policy ---
# FAIL CLOSED. If the MongoDB-backed counter itself cannot be
# read/written (a genuine database outage), every route that calls
# enforceRateLimit() (login, register, forgot-password, reset-password,
# coupon validation) returns 503 "Service temporarily unavailable" rather
# than silently letting the request through unprotected. Documented
# availability tradeoff: a real rate-limit-store outage makes these
# specific endpoints unavailable, not insecure. See lib/http.js's
# RateLimitStoreError handling.

# --- 429 response contract ---
# Generic message, a valid integer Retry-After header, the app's existing
# {success:false, message} JSON shape, and never any internal detail
# (keys, hashes, counters, database errors) — see lib/http.js's
# RateLimitExceededError handling.

# --- Security headers / CSP ---
# HSTS: production only (next start always runs as production regardless
# of NODE_ENV — see proxy.js), no `includeSubDomains`, no `preload`. This
# repository has no evidence about this deployment's actual subdomain
# topology or HTTPS-only status for every subdomain, and `preload` in
# particular is very hard to reverse once a browser vendor has baked a
# domain into its list — enabling either is a decision for whoever owns
# the real production domain, not one this codebase makes on your behalf.
#
# CSP is NONCE-based for HTML pages (proxy.js), not a static policy — real
# built-output evidence (inspecting an actual `next start` response, then
# confirmed in a real browser) showed Next.js's App Router injects
# genuinely inline <script> tags (the React Server Component streaming
# payload and React's own hydration bootstrap) that a static
# `script-src 'self'` alone would break; the alternative of adding
# `'unsafe-inline'` to script-src instead of a nonce was rejected as
# defeating the point of the CSP. Nonce-based CSP requires dynamic
# rendering — verified this costs nothing extra here, since this app's
# build output already marks every single page (not just the API routes)
# as dynamic (Phase 2's session-cookie check touches nearly every route).
# API routes get a separate, simpler, non-nonce CSP (no inline script to
# allow there at all).
#
# style-src carries a narrow, evidence-based 'unsafe-inline' exception:
# real browser testing (not just static HTML inspection) caught actual CSP
# violations from framer-motion (used in ~27 components) setting inline
# `style="..."` attributes imperatively to drive animations — this cannot
# be covered by a nonce (nonces don't apply to an element's own `style`
# attribute) or a fixed hash (the exact value changes every frame).
# script-src has NO unsafe-inline/unsafe-eval in production.
#
# img-src allows only https://res.cloudinary.com — the one real external
# origin several components' raw <img> tags actually point at. Note:
# scripts/seedCatalog.mjs's demo/seed data uses placehold.co placeholder
# images, which this CSP correctly blocks — that is expected, not a bug;
# real production images always come from the actual Cloudinary upload
# flow, and the CSP is intentionally built from real application usage,
# not loosened to accommodate a local seed-script convenience.
